
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Ma présentation Web</title>
</head>

<body>

    <!-- Titre principal -->
    <h1>Bienvenue sur ma page Web</h1>

    <!-- Présentation -->
